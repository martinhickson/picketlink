<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="Servlet 5.0"/>

    <container qualifier="wildfly-managed" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home}</property>
            <property name="allowConnectingToRunningServer">false</property>
            <property name="host">${test.host}</property>
            <property name="port">${test.http.port}</property>
            <property name="managementAddress">${test.host}</property>
            <property name="managementPort">10090</property>
            <property name="javaVmArguments">-Xms512m -Xmx512m -Djboss.bind.address=${test.host} -Djboss.bind.address.management=${test.host} -Djboss.socket.binding.port-offset=100</property>
        </configuration>
    </container>
</arquillian>
