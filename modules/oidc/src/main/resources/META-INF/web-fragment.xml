<?xml version="1.0" encoding="UTF-8"?>
<web-fragment xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-fragment_6_0.xsd"
              version="6.0" metadata-complete="false">
    <name>picketlink-oidc</name>
    <listener>
        <listener-class>org.picketlink.oidc.provider.OidcProviderServletContextListener</listener-class>
    </listener>
    <servlet>
        <servlet-name>oidc-authorize</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.AuthorizationEndpointServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-authorize</servlet-name>
        <url-pattern>/authorize</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-par</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.PushedAuthorizationRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-par</servlet-name>
        <url-pattern>/par</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-device-authorization</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.DeviceAuthorizationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-device-authorization</servlet-name>
        <url-pattern>/device_authorization</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-device</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.DeviceVerificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-device</servlet-name>
        <url-pattern>/device</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-token</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.OidcTokenEndpointServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-token</servlet-name>
        <url-pattern>/token</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-userinfo</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.UserInfoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-userinfo</servlet-name>
        <url-pattern>/userinfo</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-logout</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.LogoutEndpointServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-introspect</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.ProviderTokenManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-introspect</servlet-name>
        <url-pattern>/introspect</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-revoke</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.ProviderTokenManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-revoke</servlet-name>
        <url-pattern>/revoke</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-jwks</servlet-name>
        <servlet-class>org.picketlink.auth.oauth.servlet.JwksServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-jwks</servlet-name>
        <url-pattern>/jwks.json</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>oidc-discovery</servlet-name>
        <servlet-class>org.picketlink.oidc.provider.DiscoveryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>oidc-discovery</servlet-name>
        <url-pattern>/.well-known/openid-configuration</url-pattern>
    </servlet-mapping>
</web-fragment>
